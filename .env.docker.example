# Docker Environment Variables
# Copy this file to .env.docker and update with your values

# API Configuration
API_URL=http://host.docker.internal:8080/v1

# CDN Configuration
NEXT_PUBLIC_CLIENT_ID=your_cdn_client_id_here
NEXT_PUBLIC_CLIENT_SECRET=your_cdn_client_secret_here


# Node Environment
NODE_ENV=production

# Port Configuration
PORT=3000

# Hostname (for Docker container)
HOSTNAME=0.0.0.0